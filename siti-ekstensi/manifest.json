{
  "manifest_version": 3,
  "name": "Mata-Mata Siti",
  "version": "1.0",
  "description": "Melaporkan doomscrolling langsung ke desktop pet.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ]
}